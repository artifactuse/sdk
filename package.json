{
  "name": "artifactuse",
  "version": "0.4.3",
  "type": "module",
  "description": "The Artifact SDK for AI Agents - Turn AI outputs into interactive experiences",
  "author": "Artifactuse",
  "license": "MIT",
  "homepage": "https://artifactuse.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/artifactuse/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/artifactuse/sdk/issues"
  },
  "keywords": [
    "ai",
    "artifacts",
    "sdk",
    "chat",
    "llm",
    "claude",
    "openai",
    "agent",
    "vue",
    "react",
    "svelte"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vue": {
      "import": "./dist/vue/index.js",
      "types": "./dist/vue/index.d.ts"
    },
    "./vue2": {
      "import": "./dist/vue2/index.js",
      "types": "./dist/vue2/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./svelte": {
      "import": "./dist/svelte/index.js",
      "types": "./dist/svelte/index.d.ts"
    },
    "./widget/vanilla": {
      "import": "./dist/widget/vanilla.js",
      "types": "./dist/widget/vanilla.d.ts"
    },
    "./styles": "./dist/styles/artifactuse.css",
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "npm run dev:vue3",
    "dev:vue3": "cd playground/vue3 && npm run dev",
    "dev:vue2": "cd playground/vue2 && npm run dev",
    "dev:react": "cd playground/react && npm run dev",
    "dev:svelte": "cd playground/svelte && npm run dev",
    "build": "vite build && npm run build:vue2 && npm run build:types",
    "build:vue2": "node scripts/build-vue2.js",
    "build:types": "tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-python": "^6.1.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.0.0",
    "portal-vue": "^2.1.0",
    "prismjs": "^1.29.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "svelte": "^4.0.0 || ^5.0.0",
    "vue": "^2.7.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lang-javascript": {
      "optional": true
    },
    "@codemirror/lang-python": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "portal-vue": {
      "optional": true
    },
    "prismjs": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^8.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-vue": "^5.1.9",
    "svelte": "^5.46.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue": "^3.5.0",
    "vue-template-compiler": "^2.7.16",
    "vue2": "npm:vue@^2.7.16"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "marked": "^17.0.1"
  }
}
